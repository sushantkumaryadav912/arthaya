{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArthayaAnalysisOutputSchema",
  "description": "Output schema produced by the Arthaya multi-agent equity analysis platform.",
  "type": "object",
  "required": [
    "analysisId",
    "ticker",
    "horizon",
    "depth",
    "status",
    "agents",
    "events",
    "prediction",
    "critic",
    "summary",
    "createdAt",
    "completedAt"
  ],
  "properties": {
    "analysisId": { "type": "string" },
    "ticker": { "type": "string" },
    "horizon": { "type": "string", "enum": ["1D", "5D", "20D"] },
    "horizonDays": { "type": "integer" },
    "depth": { "type": "string", "enum": ["quick", "standard", "deep"] },
    "status": { "type": "string", "enum": ["completed", "failed"] },
    "modelGateway": { "type": "string" },
    "coordinationTrace": {
      "type": "object",
      "properties": {
        "conflictDetected": { "type": "boolean" },
        "replanningIterations": { "type": "integer" },
        "arbitrationSummary": { "type": "string" }
      }
    },
    "prediction": {
      "type": "object",
      "required": ["direction", "probability", "confidence", "breakdown"],
      "properties": {
        "direction": { "type": "string", "enum": ["UP", "DOWN", "NEUTRAL"] },
        "probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "string", "enum": ["Low", "Moderate", "Medium-High", "High"] },
        "breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "model": { "type": "string" },
              "direction": { "type": "string" },
              "probability": { "type": "number" },
              "weight": { "type": "number" }
            }
          }
        }
      }
    },
    "critic": {
      "type": "object",
      "required": ["dataQuality", "modelQuality", "signalAgreement", "potentialLeakage", "notes"],
      "properties": {
        "dataQuality": { "type": "number" },
        "modelQuality": { "type": "number" },
        "signalAgreement": { "type": "number" },
        "potentialLeakage": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "required": ["overallSignal", "probability", "technicalView", "fundamentalView", "newsView", "riskFactors"],
      "properties": {
        "overallSignal": { "type": "string" },
        "probability": { "type": "number" },
        "technicalView": { "type": "string" },
        "fundamentalView": { "type": "string" },
        "newsView": { "type": "string" },
        "riskFactors": { "type": "array", "items": { "type": "string" } },
        "conflictingSignals": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "sampleOutput": {
    "analysisId": "an_AAPL_5D_1728800000000",
    "ticker": "AAPL",
    "horizon": "5D",
    "horizonDays": 5,
    "depth": "deep",
    "status": "completed",
    "modelGateway": "claude",
    "coordinationTrace": {
      "conflictDetected": true,
      "replanningIterations": 1,
      "arbitrationSummary": "Critic detected technical vs news divergence; Orchestrator triggered adaptive ensemble recalibration."
    },
    "prediction": {
      "direction": "UP",
      "probability": 0.58,
      "confidence": "Moderate",
